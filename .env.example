# API keys for the "Loud or Right?" experiment.
# Fill in what you have and leave the rest empty. Nothing here is required:
# with no keys the experiment runs on local models only.
# Do not paste keys into chat. This file is listed in .gitignore.
# Format: NAME=value with no quotes and no spaces around the equals sign.

# --- 1. OpenAI (most useful) ------------------------------------------------
# Lets us run the GPT-6 models that the closest published paper tested.
OPENAI_API_KEY=
# Only if your account needs them:
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=

# --- 2. Google --------------------------------------------------------------
# Fill EITHER the Gemini API key (simplest) OR the three Vertex AI lines.
GEMINI_API_KEY=
# Vertex AI: project id, region (for example us-central1), and the full path
# to a service-account JSON key file on this machine.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
GOOGLE_APPLICATION_CREDENTIALS=

# --- 3. Anthropic -----------------------------------------------------------
ANTHROPIC_API_KEY=

# --- 4. OpenRouter (optional) -----------------------------------------------
# One key for mid-size open-weight models that do not fit on the local GPU.
OPENROUTER_API_KEY=

# --- Spending caps, US dollars per provider ---------------------------------
# A run stops when its cap is reached. Change these to whatever you are
# comfortable with; 0 means "do not use this provider".
BUDGET_USD_OPENAI=25
BUDGET_USD_GOOGLE=25
BUDGET_USD_ANTHROPIC=15
BUDGET_USD_OPENROUTER=20
BUDGET_USD_DEEPSEEK=5

# --- 5. DeepSeek (exploratory recency tier: DeepSeek V4.1 Flash) ---
# Paste the key after the equals sign, with no quotes and no spaces.
DEEPSEEK_API_KEY=
